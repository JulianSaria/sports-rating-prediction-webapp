+    t.equal(inspect(obj, { customInspect: 'symbol' }), falseResult);
+    t.equal(inspect(obj, { customInspect: false }), falseResult);
+    t['throws'](
+        function () { inspect(obj, { customInspect: 'not a boolean or "symbol"' }); },
